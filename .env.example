# ==========================================
# Voice RAG - Environment Configuration
# ==========================================

# 1. LLM Provider API Keys (Optional - System auto-falls back to Mock if unset)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Get your key at: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=your_cerebras_api_key_here

# 2. Sarvam AI API Key for Indic STT, LLM & Bulbul TTS (Optional)
# Get your key at: https://dashboard.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here

# 3. Application Performance & Indexing
# Controls how many Hindi MSMARCO passages to index into FAISS on startup
MAX_PASSAGES=5000

# Server Host & Port
HOST=127.0.0.1
PORT=8000
